# Copy this file to .env and fill in your own values.
# .env is gitignored. NEVER commit real keys.
# Each part of the kit only needs the keys relevant to it; leave the rest blank.

# ── LLM (used everywhere: scoring, drafting, writing) ──────────────
# An Anthropic API key, or swap for your provider of choice.
ANTHROPIC_API_KEY=
# Optional: pin a model. See your provider's current model list.
LLM_MODEL=

# ── Part 2: Hot-Content Engine ─────────────────────────────────────
# Social/data providers (pick the ones you use; all optional).
TWITTER_API_KEY=          # e.g. a twitterapi.io key for X search
LINKEDIN_API_KEY=         # e.g. a HarvestAPI key for LinkedIn
# Dedicated newsletter inbox (IMAP) — for the email source.
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_IMAP_HOST=imap.gmail.com
# Telegram (optional) — Telethon API credentials + session string.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
# Output: a Google Sheet for the ranked "Ideas" board.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=secrets/google-service-account.json
# Optional: Slack incoming webhook for team digests.
SLACK_WEBHOOK_URL=

# ── Part 3: SEO & Backlinks ────────────────────────────────────────
# Ahrefs API v3 token (or use the Ahrefs MCP server — see docs/ahrefs-setup.md).
AHREFS_API_KEY=
# Optional: email-finder for outreach contact lookup.
HUNTER_API_KEY=
