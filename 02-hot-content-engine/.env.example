# Part 2 — Hot-Content Engine. Copy to .env (gitignored). All optional; add as you add sources.

# LLM for scoring + drafting
ANTHROPIC_API_KEY=
LLM_MODEL=

# Social data providers (paid; run once a day)
TWITTER_API_KEY=
LINKEDIN_API_KEY=

# Dedicated newsletter inbox (IMAP, laptop)
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_IMAP_HOST=imap.gmail.com

# Telegram (your own Telethon session, laptop)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# Output board: Google Sheet
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=secrets/google-service-account.json

# Optional: Slack digest webhook
SLACK_WEBHOOK_URL=

# Scoring knobs
RELEVANCE_FLOOR=40
